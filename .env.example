# Required: the link from the server kit (root or /history both work). Alias: NGROK_URL
SERVER_URL=https://dashboard:CHANGE_ME@my-server.tailnet-name.ts.net/history

# Added automatically by the Neon integration (POSTGRES_URL also read).
# Local dev without Neon: DATABASE_URL=pglite:./.data  (embedded Postgres, enables accounts + history)
DATABASE_URL=

# Optional
# Signs logins and encrypts saved server links. Any long random string (recommended).
SESSION_SECRET=
# 1 = stop new accounts being created
DISABLE_SIGNUP=
# 1 = allow account links to private / LAN addresses (self-hosted dashboards only)
ALLOW_PRIVATE_LINKS=
DASHBOARD_PASSWORD=
VIEWER_PASSWORD=
CRON_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
